# ========== 依赖与构建产物 ==========
node_modules/
dist/
.env
.env.*
!.env.example
!.env.production

# ========== 日志 ==========
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== 运行时临时文件 ==========
*.tmp
*.bak
*.swp
*.swo
*~
backend/_*.js          # 后端临时调试脚本（如 _check.js）
backend/_*.sql

# ========== 编辑器 / IDE ==========
.vscode/
!.vscode/extensions.json
.idea/
*.code-workspace
.tern-port

# ========== 操作系统 ==========
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========== 测试与覆盖率 ==========
coverage/
.nyc_output/
*.test.js
*.spec.js

# ========== Markdown 文档（仅 README 入库） ==========
*.md
!README.md
