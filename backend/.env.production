# Production environment template for Ubuntu server
# Usage on server:
#   cp .env.production .env
#   nano .env           # IMPORTANT: replace placeholders below, especially DB_PASSWORD and JWT_SECRET
#
# Variable names must match backend code (config/db.js reads DB_PASSWORD, auth.routes.js reads JWT_SECRET)

# Server port (PM2 listens on 3000, Nginx reverse-proxies to this port)
PORT=3000

# MySQL connection (self-hosted MySQL or remote instance)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here      # REQUIRED: production MySQL password
DB_NAME=trade_system

# JWT secret (REQUIRED: 32+ byte random hex; token forgery risk if left as placeholder)
# Generate on server: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32_output
JWT_EXPIRES_IN=12h

# Runtime flag
NODE_ENV=production

# CORS allowlist (optional; Express defaults to '*'. Recommend domain or server IP in production)
# CORS_ORIGIN=http://your-domain.com,http://your-server-ip
