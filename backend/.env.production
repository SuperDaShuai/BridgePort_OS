# ─── 生产环境配置（部署到 Ubuntu 服务器时使用）───
# 用法：在服务器上把本文件改名为 .env 即可被 config/db.js 与 auth.routes.js 读取
#   cp .env.production .env && nano .env   # 填入真实密码后保存
#
# 注意：变量名必须与现有代码对齐 ——
#   config/db.js 读取 DB_PASSWORD（不是 DB_PASS）
#   routes/auth.routes.js 读取 JWT_SECRET（缺失会导致登录接口崩溃）

# ─── 服务端口 ───
PORT=3000

# ─── MySQL 连接 ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=trade_system

# ─── JWT 鉴权（务必改成随机长字符串，否则 token 可被伪造）───
JWT_SECRET=b9b360a58ab4ab4d11330302c1462638bca58fdd933173e0ec9f5e42fc018e5a
JWT_EXPIRES_IN=12h

# ─── 运行环境标识（前端 axios 可据此切换 baseURL）───
NODE_ENV=production
